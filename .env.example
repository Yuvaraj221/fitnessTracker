# FORGE environment variables. All are optional for local use.
# On Vercel, set them in Project → Settings → Environment Variables.

# Vercel Blob read/write token. Added automatically when you connect a Blob store
# to the Vercel project. When present, CSV files are stored in Vercel Blob
# (persistent). Without it, a Vercel deployment uses temporary storage.
# BLOB_READ_WRITE_TOKEN=

# Protects the deployed API and UI with a shared key you type once per device.
# Strongly recommended for any public URL.
# FORGE_ACCESS_KEY=

# filesystem | blob  (defaults to blob when BLOB_READ_WRITE_TOKEN is set)
# FORGE_STORAGE=
# Folder (prefix) inside the Blob store. Default: forge/
# FORGE_BLOB_PREFIX=forge/
# private (recommended) | public — must match the access type of your Blob store.
# FORGE_BLOB_ACCESS=private

# Seed demo data into a brand-new, empty store. Default: true on Vercel, false locally.
# FORGE_SEED_SAMPLE_DATA=

# Local-only settings
# FORGE_API_PORT=4000
# FORGE_DATA_DIR=./data
# FORGE_BACKUP_DIR=./backups
# FORGE_AUTO_BACKUP_RETENTION=40
